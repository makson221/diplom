<?xml version="1.0" encoding="utf-8"?>
<!-- Налаштування для хостингу на IIS (MonsterASP.NET, SmarterASP, Azure App Service на Windows тощо). -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\WorksArchive.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering>
          <!-- Дозволяємо завантаження файлів до 110 МБ (за замовчуванням IIS — лише 30 МБ). -->
          <requestLimits maxAllowedContentLength="115343360" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
