@page
@model WorksArchive.Pages.Works.IndexModel
@{
    ViewData["Title"] = "Роботи";
    var f = Model.Filter;
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h3 class="mb-0"><i class="bi bi-folder2-open text-primary"></i> Роботи студентів</h3>
    <a href="/Works/Upload" class="btn btn-success"><i class="bi bi-plus-lg"></i> Додати роботу</a>
</div>

<form method="get" class="card p-3 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small text-muted mb-1">Група</label>
            <select name="GroupId" class="form-select">
                <option value="">Усі групи</option>
                @foreach (var g in Model.Groups)
                {
                    <option value="@g.Id" selected="@(f.GroupId == g.Id)">@g.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small text-muted mb-1">Рік здачі</label>
            <select name="Year" class="form-select">
                <option value="">Усі роки</option>
                @foreach (var y in Model.Years)
                {
                    <option value="@y" selected="@(f.Year == y)">@y</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small text-muted mb-1">Тип</label>
            <select name="Type" class="form-select">
                <option value="">Усі</option>
                <option value="@WorkType.Coursework" selected="@(f.Type == WorkType.Coursework)">Курсові</option>
                <option value="@WorkType.Diploma" selected="@(f.Type == WorkType.Diploma)">Дипломні</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small text-muted mb-1">Пошук</label>
            <input name="Q" value="@f.Q" class="form-control" placeholder="ПІБ або тема" />
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button class="btn btn-primary flex-fill"><i class="bi bi-funnel"></i> Знайти</button>
            <a href="/Works" class="btn btn-outline-secondary" title="Скинути"><i class="bi bi-x-lg"></i></a>
        </div>
    </div>
</form>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
    <div class="text-muted">Знайдено: <b>@Model.Total</b> @(Model.TotalSize > 0 ? $"({WorkService.FormatSize(Model.TotalSize)})" : "")</div>
    @if (Model.Total > 0)
    {
        <a class="btn btn-outline-primary" asp-page-handler="Zip"
           asp-route-GroupId="@f.GroupId" asp-route-Year="@f.Year" asp-route-Type="@f.Type" asp-route-Q="@f.Q">
            <i class="bi bi-file-earmark-zip"></i> Завантажити все знайдене (ZIP)
        </a>
    }
</div>

@if (Model.Items.Count == 0)
{
    <div class="card p-5 text-center text-muted"><i class="bi bi-inbox display-5"></i><div class="mt-2">Робіт не знайдено</div></div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Студент</th>
                        <th>Тема</th>
                        <th>Тип</th>
                        <th>Група</th>
                        <th>Рік</th>
                        <th>Файл</th>
                        <th>Додано</th>
                        <th class="text-end">Дії</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var w in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">@w.StudentName</td>
                        <td><div class="text-truncate-2" title="@w.Title">@w.Title</div></td>
                        <td>
                            <span class="badge @(w.Type == WorkType.Diploma ? "text-bg-warning" : "text-bg-info")">
                                @(w.Type == WorkType.Diploma ? "Диплом" : "Курсова")
                            </span>
                        </td>
                        <td>@w.Group.Name</td>
                        <td>@w.Year</td>
                        <td class="small"><div class="text-truncate" style="max-width:180px" title="@w.OriginalFileName">@w.OriginalFileName</div>
                            <span class="text-muted">@WorkService.FormatSize(w.SizeBytes)</span></td>
                        <td class="small text-muted">@w.UploadedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")<br />@(w.UploadedBy ?? "студент")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-primary" asp-page-handler="Download" asp-route-id="@w.Id" title="Завантажити"><i class="bi bi-download"></i></a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@w.Id" class="d-inline"
                                  onsubmit="return confirm('Видалити роботу «@w.StudentName»? Файл буде видалено зі сховища.');">
                                <button class="btn btn-sm btn-outline-danger" title="Видалити"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.Pages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination justify-content-center">
                @for (var p = 1; p <= Model.Pages; p++)
                {
                    <li class="page-item @(p == Model.PageNo ? "active" : "")">
                        <a class="page-link" asp-route-GroupId="@f.GroupId" asp-route-Year="@f.Year" asp-route-Type="@f.Type" asp-route-Q="@f.Q" asp-route-p="@p">@p</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
