@page
@model WorksArchive.Pages.UploadModel
@{
    ViewData["Title"] = "Здати роботу";
}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card p-4">
            <h3 class="mb-1"><i class="bi bi-cloud-arrow-up text-primary"></i> Здати роботу</h3>
            <p class="text-muted">Файл побачить лише викладач. Після відправки змінити його самостійно не можна — у разі помилки зверніться до викладача.</p>

            @if (!Model.Allowed)
            {
                <div class="alert alert-warning mb-0"><i class="bi bi-lock"></i> Прийом робіт зараз закрито.</div>
            }
            else if (Model.Done)
            {
                <div class="alert alert-success">
                    <i class="bi bi-check-circle"></i> Роботу успішно відправлено! Дякуємо.
                </div>
                <a href="/Upload" class="btn btn-outline-primary">Відправити ще одну</a>
            }
            else if (!Model.Groups.Any())
            {
                <div class="alert alert-info mb-0">Адміністратор ще не додав жодної групи.</div>
            }
            else
            {
                <form method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                    <partial name="_WorkFields" for="Input" view-data="@(new ViewDataDictionary(ViewData) { ["Groups"] = Model.Groups })" />
                    <div class="row g-3 mt-0">
                        <div class="col-md-8">
                            <label class="form-label" for="WorkFile">Файл роботи</label>
                            <input type="file" name="WorkFile" id="WorkFile" class="form-control" accept="@Model.Accept" required />
                            <div class="form-text">PDF, DOC/DOCX, ZIP/RAR тощо, до @Model.MaxMb МБ.</div>
                            <span asp-validation-for="WorkFile" class="text-danger small"></span>
                        </div>
                        @if (Model.CodeRequired)
                        {
                            <div class="col-md-4">
                                <label class="form-label" asp-for="Code"></label>
                                <input asp-for="Code" class="form-control" />
                                <div class="form-text">Повідомляє викладач.</div>
                                <span asp-validation-for="Code" class="text-danger small"></span>
                            </div>
                        }
                    </div>
                    <button class="btn btn-primary mt-4" id="submitBtn">
                        <i class="bi bi-send"></i> Відправити
                    </button>
                </form>
            }
        </div>
    </div>
</div>
@section Scripts {
    <script>
        document.querySelector('form')?.addEventListener('submit', () => {
            const b = document.getElementById('submitBtn');
            b.disabled = true;
            b.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Завантаження...';
        });
    </script>
}
