@page
@model WorksArchive.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Користувачі";
}
<h3 class="mb-4"><i class="bi bi-people text-primary"></i> Користувачі</h3>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr><th>ПІБ</th><th>Логін</th><th>Роль</th><th>Статус</th><th class="text-end">Дії</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var u in Model.Users)
                    {
                        var isMe = u.Id == Model.CurrentUserId;
                        <tr class="@(u.IsActive ? "" : "table-secondary")">
                            <td>@u.FullName @if (isMe) { <span class="badge text-bg-secondary">це ви</span> }</td>
                            <td><code>@u.Login</code></td>
                            <td>
                                <span class="badge @(u.Role == UserRole.Admin ? "text-bg-danger" : "text-bg-primary")">@u.Role.ToUa()</span>
                            </td>
                            <td>@(u.IsActive ? "Активний" : "Заблокований")</td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#edit-@u.Id" title="Редагувати">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                @if (!isMe)
                                {
                                    <form method="post" asp-page-handler="ToggleActive" asp-route-id="@u.Id" class="d-inline">
                                        <button class="btn btn-sm btn-outline-warning" title="@(u.IsActive ? "Заблокувати" : "Розблокувати")">
                                            <i class="bi @(u.IsActive ? "bi-lock" : "bi-unlock")"></i>
                                        </button>
                                    </form>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@u.Id" class="d-inline"
                                          onsubmit="return confirm('Видалити користувача @u.Login?');">
                                        <button class="btn btn-sm btn-outline-danger" title="Видалити"><i class="bi bi-trash"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                        <tr class="collapse" id="edit-@u.Id">
                            <td colspan="5" class="bg-light">
                                <form method="post" asp-page-handler="Update" asp-route-id="@u.Id" class="row g-2 align-items-end">
                                    <div class="col-md-4">
                                        <label class="form-label small mb-1">ПІБ</label>
                                        <input name="fullName" value="@u.FullName" class="form-control form-control-sm" required maxlength="150" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small mb-1">Роль</label>
                                        <select name="role" class="form-select form-select-sm" disabled="@isMe">
                                            <option value="@UserRole.Teacher" selected="@(u.Role == UserRole.Teacher)">Викладач</option>
                                            <option value="@UserRole.Admin" selected="@(u.Role == UserRole.Admin)">Адміністратор</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small mb-1">Новий пароль</label>
                                        <input name="newPassword" type="password" class="form-control form-control-sm" placeholder="не змінювати" minlength="6" autocomplete="new-password" />
                                    </div>
                                    <div class="col-md-2">
                                        <button class="btn btn-sm btn-primary w-100">Зберегти</button>
                                    </div>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card p-3">
            <h5><i class="bi bi-person-plus"></i> Новий користувач</h5>
            <form method="post" asp-page-handler="Create">
                <div asp-validation-summary="All" class="text-danger small"></div>
                <div class="mb-2">
                    <label asp-for="NewUser.FullName" class="form-label"></label>
                    <input asp-for="NewUser.FullName" class="form-control" />
                </div>
                <div class="mb-2">
                    <label asp-for="NewUser.Login" class="form-label"></label>
                    <input asp-for="NewUser.Login" class="form-control" autocomplete="off" />
                </div>
                <div class="mb-2">
                    <label asp-for="NewUser.Password" class="form-label"></label>
                    <input asp-for="NewUser.Password" class="form-control" autocomplete="new-password" />
                </div>
                <div class="mb-3">
                    <label asp-for="NewUser.Role" class="form-label"></label>
                    <select asp-for="NewUser.Role" class="form-select">
                        <option value="@UserRole.Teacher">Викладач</option>
                        <option value="@UserRole.Admin">Адміністратор</option>
                    </select>
                </div>
                <button class="btn btn-success w-100"><i class="bi bi-plus-lg"></i> Створити</button>
            </form>
        </div>
    </div>
</div>
