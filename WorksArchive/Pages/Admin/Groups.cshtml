@page
@model WorksArchive.Pages.Admin.GroupsModel
@{
    ViewData["Title"] = "Групи";
}
<h3 class="mb-4"><i class="bi bi-collection text-primary"></i> Групи</h3>
<div class="row g-3">
    <div class="col-lg-8">
        <div class="card">
            <table class="table table-hover mb-0">
                <thead class="table-head"><tr><th>Назва</th><th>Робіт</th><th class="text-end">Дії</th></tr></thead>
                <tbody>
                @if (Model.Rows.Count == 0)
                {
                    <tr><td colspan="3" class="text-center text-muted py-4">Груп ще немає — додайте першу праворуч.</td></tr>
                }
                @foreach (var g in Model.Rows)
                {
                    <tr>
                        <td>
                            <form method="post" asp-page-handler="Rename" asp-route-id="@g.Id" class="d-flex gap-2">
                                <input name="name" value="@g.Name" class="form-control form-control-sm" style="max-width:220px" required maxlength="50" />
                                <button class="btn btn-sm btn-outline-secondary" title="Перейменувати"><i class="bi bi-check-lg"></i></button>
                            </form>
                        </td>
                        <td><a href="/Works?GroupId=@g.Id">@g.Count</a></td>
                        <td class="text-end">
                            <form method="post" asp-page-handler="Delete" asp-route-id="@g.Id" class="d-inline"
                                  onsubmit="return confirm('Видалити групу @g.Name?');">
                                <button class="btn btn-sm btn-outline-danger" disabled="@(g.Count > 0)"
                                        title="@(g.Count > 0 ? "Спершу видаліть роботи групи" : "Видалити")"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card p-3">
            <h5><i class="bi bi-plus-circle"></i> Нова група</h5>
            <form method="post" asp-page-handler="Create">
                <input name="name" class="form-control mb-2" placeholder="Наприклад, КН-41" required maxlength="50" />
                <button class="btn btn-success w-100">Додати</button>
            </form>
            <hr />
            <h6>Додати кілька одразу</h6>
            <form method="post" asp-page-handler="Bulk">
                <textarea name="names" class="form-control mb-2" rows="4" placeholder="Кожна група з нового рядка"></textarea>
                <button class="btn btn-outline-success w-100">Додати всі</button>
            </form>
        </div>
    </div>
</div>
