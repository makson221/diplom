@page
@model WorksArchive.Pages.Admin.SettingsModel
@{
    ViewData["Title"] = "Налаштування";
}
<h3 class="mb-4"><i class="bi bi-sliders text-primary"></i> Налаштування</h3>
<div class="row">
    <div class="col-lg-7">
        <div class="card p-4">
            <form method="post">
                <h5>Прийом робіт від студентів</h5>
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" role="switch" id="allow" name="AllowStudentUpload" value="true" checked="@Model.AllowStudentUpload" />
                    <label class="form-check-label" for="allow">Студенти можуть здавати роботи через сторінку «Здати роботу»</label>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="code">Код доступу для студентів</label>
                    <input class="form-control" id="code" name="StudentUploadCode" value="@Model.StudentUploadCode" maxlength="64" autocomplete="off" />
                    <div class="form-text">Якщо заповнено — студент має ввести цей код, щоб відправити роботу. Залиште порожнім, щоб не вимагати код.</div>
                </div>
                <h5 class="mt-4">Тема за замовчуванням</h5>
                <p class="small text-body-secondary">Діє для всіх, хто ще не обрав свою тему через <i class="bi bi-palette"></i> у верхньому меню.</p>
                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label class="form-label" for="mode">Режим</label>
                        <select class="form-select" id="mode" name="DefaultMode">
                            @foreach (var m in Themes.Modes)
                            {
                                <option value="@m.Key" selected="@(m.Key == Model.DefaultMode)">@m.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label" for="accent">Колір</label>
                        <select class="form-select" id="accent" name="DefaultAccent">
                            @foreach (var a in Themes.Accents)
                            {
                                <option value="@a.Key" selected="@(a.Key == Model.DefaultAccent)">@a.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <button class="btn btn-primary"><i class="bi bi-save"></i> Зберегти</button>
            </form>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card p-4">
            <h5>Сховище файлів</h5>
            <p class="small text-body-secondary">Заповненість сховища та підключення Google Drive — на окремій сторінці.</p>
            <a href="/Admin/Storage" class="btn btn-outline-primary"><i class="bi bi-hdd-stack"></i> Сховище</a>
        </div>
    </div>
</div>
